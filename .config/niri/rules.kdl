window-rule {
    geometry-corner-radius 0
    clip-to-geometry true
}

window-rule {
    match app-id="com.microsoft.VSCode"
    default-column-width { proportion 0.97; }
}

window-rule {
    match app-id="chromium-browser"
    default-column-width { proportion 0.75; }
}

window-rule {
    match app-id="scrcpy"
    default-column-width { fixed 473; }
}

window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}

window-rule {
    match app-id="com.onepassword.OnePassword"
    open-floating true
    default-column-width { fixed 1280; }
    default-window-height { fixed 760; }
}

window-rule {
    match app-id="dev.zed.Zed"
    default-column-width { proportion 0.97; }
}

window-rule {
    match app-id="org.gnome.Nautilus"
    open-floating true
    default-column-width { fixed 920; }
    default-window-height { fixed 620; }
}

layer-rule {
    match namespace="^noctalia-backdrop"
    place-within-backdrop true
}

window-rule {
  background-effect {
    blur true
    xray false
  }
}

layer-rule {
  match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
  background-effect {
    xray false
    blur false
  }
}

layer-rule {
    match namespace="noctalia-window-switcher"
    background-effect {
        blur true
        xray false
    }
}

blur {
  passes 2
  offset 3.0
  noise 0.03
  saturation 1.0
}
