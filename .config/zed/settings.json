{
  "terminal": {
    "button": false
  },
  "diff_view_style": "unified",
  "cli_default_open_behavior": "new_window",
  "git_panel": {
    "dock": "left",
    "sort_by": "name",
    "tree_view": false,
    "group_by": "staging"
  },
  "disable_ai": false,
  "edit_predictions": {
    "provider": "none"
  },
  "debugger": {
    "button": false
  },
  "collaboration_panel": {
    "button": false
  },
  "outline_panel": {
    "button": false
  },
  "agent": {
    "threads_sidebar": {
      "position": "right"
    },
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "project_panel": {
    "dock": "left"
  },
  "tab_bar": {
    "show_nav_history_buttons": false
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "agent_servers": {
    "codex-acp": {
      "type": "registry"
    },
    "claude-acp": {
      "default_config_options": {
        "fast": false,
        "model": "opus",
        "effort": "max"
      },
      "type": "registry"
    }
  },
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "buffer_font_size": 14,
  "vim_mode": true,
  "theme": {
    "mode": "system",
    "light": "Noctalia Light",
    "dark": "Noctalia Dark"
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Material Icon Theme",
    "dark": "Material Icon Theme"
  },
  "window_decorations": "server",
  "title_bar": {
    "show_menus": false,
    "show_onboarding_banner": false,
    "show_branch_name": false,
    "show_branch_status_icon": false,
    "show_user_menu": false,
    "show_user_picture": false,
    "show_sign_in": false
  }
}
